# Server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/salesportal
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Auth - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Gmail SMTP (use an App Password). Leave blank in development to print
# emails to the console instead of sending them.
EMAIL=
EMAIL_PASSWORD=
# Recipient for internal HR notifications (defaults to EMAIL)
HR_EMAIL=

# Master admin created by `npm run seed`
MASTER_ADMIN_EMAIL=master@salesportal.local
MASTER_ADMIN_PASSWORD=Master@12345
