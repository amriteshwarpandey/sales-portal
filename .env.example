# Settings for `docker compose up`. Copy to .env and fill in.

# Required: a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=

# Host ports
CLIENT_PORT=3000
API_PORT=5000

# Where the browser opens the app (comma-separate several). Must match CLIENT_PORT.
CLIENT_URL=http://localhost:3000
# Where the browser reaches Socket.IO. Must match API_PORT. Baked into the client image.
PUBLIC_SOCKET_URL=http://localhost:5000

# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# Gmail SMTP (App Password). Leave blank to print emails in the server logs.
EMAIL=
EMAIL_PASSWORD=
HR_EMAIL=

# Master admin created by the seed command
MASTER_ADMIN_EMAIL=master@salesportal.local
MASTER_ADMIN_PASSWORD=Master@12345
